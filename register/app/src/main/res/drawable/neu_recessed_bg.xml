<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_dark" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_light" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="2dp"
        android:right="4dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_surface" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
