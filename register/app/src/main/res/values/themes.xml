<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Register" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">@color/palette_white</item>
        <item name="android:navigationBarColor">@color/palette_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ProfileSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ProfileFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/home_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ProfileInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/home_search_bg</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/home_text_primary</item>
        <item name="android:textColorHint">@color/home_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ProfilePrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:background">@drawable/profile_accent_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/home_on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
