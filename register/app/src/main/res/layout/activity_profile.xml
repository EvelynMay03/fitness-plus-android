<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="60dp"
            android:paddingRight="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:padding="8dp"
                    android:src="@drawable/ic_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_subtitle"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_title"
                        android:textColor="@color/home_text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/home_card_purple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtAvatarInitial"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/profile_avatar_circle"
                    android:gravity="center"
                    android:textColor="@color/home_accent"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/home_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/home_stat_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/ProfileSectionTitle"
                    android:text="@string/profile_personal_info" />

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="@string/name" />

                <EditText
                    android:id="@+id/etProfileName"
                    style="@style/ProfileInput"
                    android:hint="@string/hint_name"
                    android:inputType="textPersonName" />

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="@string/email" />

                <EditText
                    android:id="@+id/etProfileEmail"
                    style="@style/ProfileInput"
                    android:enabled="false"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/home_text_secondary" />

                <android.widget.Button
                    android:id="@+id/btnSaveProfile"
                    style="@style/ProfilePrimaryButton"
                    android:text="@string/profile_save" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/home_card_blue"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/ProfileSectionTitle"
                    android:text="@string/profile_bmi_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ProfileFieldLabel"
                            android:layout_marginTop="10dp"
                            android:text="@string/profile_height" />

                        <EditText
                            android:id="@+id/etHeight"
                            style="@style/ProfileInput"
                            android:background="@drawable/home_duration_badge"
                            android:hint="@string/profile_height_hint"
                            android:inputType="numberDecimal" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ProfileFieldLabel"
                            android:layout_marginTop="10dp"
                            android:text="@string/profile_weight" />

                        <EditText
                            android:id="@+id/etWeight"
                            style="@style/ProfileInput"
                            android:background="@drawable/home_duration_badge"
                            android:hint="@string/profile_weight_hint"
                            android:inputType="numberDecimal" />

                    </LinearLayout>

                </LinearLayout>

                <android.widget.Button
                    android:id="@+id/btnCalculateBmi"
                    style="@style/ProfilePrimaryButton"
                    android:layout_marginTop="16dp"
                    android:text="@string/profile_calculate_bmi" />

                <LinearLayout
                    android:id="@+id/bmiResultCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/home_duration_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_bmi_label"
                            android:textColor="@color/home_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtBmiValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/home_accent"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtBmiCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/home_category_bg"
                        android:paddingLeft="14dp"
                        android:paddingTop="8dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="8dp"
                        android:textColor="@color/home_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/home_stat_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/ProfileSectionTitle"
                    android:text="@string/profile_change_password" />

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="@string/profile_current_password" />

                <EditText
                    android:id="@+id/etCurrentPassword"
                    style="@style/ProfileInput"
                    android:hint="@string/profile_current_password_hint"
                    android:inputType="textPassword" />

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="@string/profile_new_password" />

                <EditText
                    android:id="@+id/etNewPassword"
                    style="@style/ProfileInput"
                    android:hint="@string/profile_new_password_hint"
                    android:inputType="textPassword" />

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="@string/confirm_password" />

                <EditText
                    android:id="@+id/etConfirmNewPassword"
                    style="@style/ProfileInput"
                    android:hint="@string/hint_confirm_password"
                    android:inputType="textPassword" />

                <android.widget.Button
                    android:id="@+id/btnChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/home_duration_badge"
                    android:stateListAnimator="@null"
                    android:text="@string/profile_update_password"
                    android:textAllCaps="false"
                    android:textColor="@color/home_accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <android.widget.Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/profile_logout_bg"
                android:stateListAnimator="@null"
                android:text="@string/logout"
                android:textAllCaps="false"
                android:textColor="@color/home_danger"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/home_bottom_nav_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_nav_home"
            android:padding="8dp"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/navStats"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_nav_stats"
            android:padding="8dp"
            android:src="@drawable/ic_stats" />

        <ImageView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_nav_profile"
            android:padding="8dp"
            android:src="@drawable/ic_profile_filled" />

    </LinearLayout>

</LinearLayout>
